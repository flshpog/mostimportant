# Copy this file to .env and fill in the values you want to use

# Groq API key (optional — only needed if you want voice message transcription)
GROQ_API_KEY=

# Recorder bot tokens for live voice-channel transcription, comma-separated.
# One bot can only sit in one voice channel at a time, so this is how many calls
# can be transcribed at once. Leave empty to turn the feature off.
# Everything else about it is in config/vctranscription.json.
RECORDER_TOKENS=

# Season 3 board server (config/board.json has the rest).
# A long random string that signs website logins. Changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOARD_SESSION_SECRET=
# The bot application's OAuth2 client secret (Discord developer portal > OAuth2).
# Without it the board API still runs, but nobody can log in on the website.
DISCORD_CLIENT_SECRET=

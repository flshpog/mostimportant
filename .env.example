# Copy this file to .env and fill in the values you want to use

# Groq API key (optional — only needed if you want voice message transcription)
GROQ_API_KEY=

# Recorder bot tokens for live voice-channel transcription, comma-separated.
# One bot can only sit in one voice channel at a time, so this is how many calls
# can be transcribed at once. Leave empty to turn the feature off.
# Everything else about it is in config/vctranscription.json.
RECORDER_TOKENS=

{
     "name": "everest-hub-discord-bot",
     "version": "1.0.0",
     "description": "A comprehensive Discord bot for Everest Hub",
     "main": "src/index.js",
     "workspaces": [
          "packages/*",
          "apps/*"
     ],
     "scripts": {
          "start": "node src/index.js",
          "dev": "nodemon src/index.js",
          "board:validate": "npm run validate -w @everest/board-data",
          "board:test": "npm run test -w @everest/board-data -w @everest/engine -w @everest/server",
          "board:web": "npm run dev -w @everest/web",
          "board:sample": "npm run sample -w @everest/engine",
          "board:typecheck": "npm run typecheck -w @everest/board-data -w @everest/engine -w @everest/server",
          "board:dev": "npm run dev -w @everest/server --"
     },
     "dependencies": {
          "@discordjs/voice": "^0.19.2",
          "discord.js": "^14.14.1",
          "dotenv": "^16.3.1",
          "jimp": "^0.22.10",
          "openai": "^4.20.1",
          "opusscript": "^0.0.8",
          "tsx": "^4.23.15"
     },
     "devDependencies": {
          "@types/node": "^22.20.5",
          "nodemon": "^3.0.2",
          "typescript": "^5.9.3",
          "vitest": "^2.1.9"
     },
     "keywords": [
          "discord",
          "bot",
          "everest"
     ],
     "author": "Your Name",
     "license": "MIT"
}
